DATABASE_URL=sqlite:///./data/nextnews.db

AZURE_OPENAI_LLM_ENDPOINT=
AZURE_OPENAI_LLM_API_KEY=
AZURE_OPENAI_LLM_DEPLOYMENT=

AZURE_OPENAI_IMAGE_ENDPOINT=https://xxx.cognitiveservices.azure.com/
AZURE_OPENAI_IMAGE_API_KEY=
AZURE_OPENAI_IMAGE_DEPLOYMENT=
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview

# Up to this many HN stories are fetched per pipeline pass.
HN_FETCH_LIMIT=20
# Up to this many posts/images are generated per pipeline pass.
POST_GENERATION_LIMIT=1
# This does not cap the total number of posts stored in SQLite.
HN_PIPELINE_INTERVAL_SECONDS=1800

IMAGE_OUTPUT_DIR=./data/images
IMAGE_QUALITY=medium
IMAGE_SIZE=1024x1024
